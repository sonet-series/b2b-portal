// Series Tours — B2B Agent Portal
// Standalone schema. This database has NO relationship to the Frappe/ERPNext
// ERP (`series_tours_app`). Never add a connection, import, or sync to it.
//
// Conventions (see CLAUDE.md for the full rationale):
//  - Money is stored as INTEGER minor units (paise). 1500.50 INR -> 150050.
//    Field names carry the `Minor` suffix so this is impossible to miss.
//  - SQLite has no native enum type. Enum-ish columns are String, and the
//    allowed values live in src/lib/enums.ts as the single source of truth.
//  - Seasons are date ranges (validFrom/validTo), not free-text labels, so the
//    quote engine can resolve a rate from a travel date with no human input.
//  - `active` is a soft-disable everywhere. Catalogue rows are never hard
//    deleted once they have been quoted against.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes a connection URL here. The URL lives in
// prisma.config.ts (for the CLI/migrations) and reaches PrismaClient through
// the better-sqlite3 driver adapter in src/lib/db.ts.
datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

/// Sonet only. v1 deliberately has no multi-admin, no roles, no invites.
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?

  /// The seed sets this true, so the password that reaches production through
  /// an env file is dead on first use. Cleared once a real password is chosen.
  mustChangePassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Hotels
// ---------------------------------------------------------------------------

model Hotel {
  id           String   @id @default(uuid())
  name         String
  location     String // town / area, e.g. "Munnar"
  starCategory Int?
  notes        String? // internal only, never shown to agents
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rates HotelRate[]

  @@index([active, location])
}

model HotelRate {
  id      String @id @default(uuid())
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  roomType String // "Deluxe", "Suite", ...
  mealPlan String // MealPlan enum in src/lib/enums.ts: EP | CP | MAP | AP

  /// Human label for the season, shown in admin and on the quote ("Peak").
  seasonLabel String
  /// Inclusive. The quote engine matches a travel date against this window.
  validFrom   DateTime
  /// Inclusive.
  validTo     DateTime

  /// DEFAULT rate per room per night, in paise — one per agency tier.
  ///
  /// BOTH are required. Two NOT NULL columns rather than a nullable pair, for
  /// the same reason the pricing-mode columns are shaped that way: a rate row
  /// must not be able to exist that cannot price somebody. There is no
  /// fallback below these — if a tier price is missing the quote is wrong, so
  /// the schema makes missing impossible.
  ///
  /// An agent rate-card override still beats both.
  ratePerNightKeralaMinor        Int
  ratePerNightOutsideKeralaMinor Int

  /// Extra bed / extra adult sharing, per night, in paise — one per tier.
  ///
  /// Nullable as a PAIR, not individually. These charges are genuinely
  /// optional (a room type may not offer an extra bed at all), so NOT NULL
  /// would force a price for something that does not exist — and for three of
  /// the five ancillary charges the pricing-mode rules actively FORBID a value.
  /// What must never happen is one tier set and the other missing: that is the
  /// "cannot price somebody" failure the required main-rate columns prevent.
  ///
  /// Both-or-neither is enforced in src/lib/validation.ts, which is the only
  /// write path.
  extraBedKeralaMinor        Int?
  extraBedOutsideKeralaMinor Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId, active])
  @@index([validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Houseboats
//
// No prior schema existed for these anywhere (unlike hotels and vehicles), so
// this shape is a fresh design. See CLAUDE.md "Houseboat pricing design" for
// why it is modelled per-cruise rather than per-night-per-person.
// ---------------------------------------------------------------------------

model Houseboat {
  id       String  @id @default(uuid())
  name     String
  /// Third-party operator, if we do not run the boat ourselves.
  operator String?
  /// HouseboatCategory enum: Deluxe | Premium | Luxury | Super Luxury
  category String
  bedrooms Int
  location String // "Alleppey", "Kumarakom", ...

  /// Free-text, agent-visible: "AC bedrooms 9pm-6am, upper deck, sundeck".
  amenities String?
  notes     String? // internal only
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates HouseboatRate[]

  @@index([active, location, category])
}

model HouseboatRate {
  id          String    @id @default(uuid())
  houseboatId String
  houseboat   Houseboat @relation(fields: [houseboatId], references: [id], onDelete: Cascade)

  /// CruisePackage enum: DAY_CRUISE | OVERNIGHT_22HR | TWO_NIGHT
  cruisePackage String

  /// HouseboatPricingMode enum: WHOLE_BOAT | PER_PERSON
  ///
  /// Lives on the RATE row, not on Houseboat, because the same boat may sell
  /// whole-boat for an overnight cruise and per-person on a day cruise. A boat
  /// that offers both modes for the same duration simply has two rate rows,
  /// and the agent sees both as separate priced options.
  pricingMode String

  /// Meals bundled into the cruise price. Almost always full board for
  /// overnight; kept explicit so a day cruise can differ.
  mealPlan String // MealPlan enum

  seasonLabel String
  validFrom   DateTime
  validTo     DateTime

  /// DEFAULT rate in paise, one per agency tier. Its UNIT depends on
  /// pricingMode:
  ///   WHOLE_BOAT -> the whole boat, one cruise
  ///   PER_PERSON -> one person, one cruise
  /// Both required — see the note on HotelRate.
  rateKeralaMinor        Int
  rateOutsideKeralaMinor Int

  /// WHOLE_BOAT only: pax covered by rateMinor before extra-pax billing.
  includedPax Int?
  /// WHOLE_BOAT only: per extra person beyond includedPax, per cruise, in
  /// paise — one per tier, both-or-neither. See HotelRate.extraBed*.
  extraPaxKeralaMinor        Int?
  extraPaxOutsideKeralaMinor Int?

  /// PER_PERSON only: the boat will not run below this headcount, so a 2-pax
  /// enquiry on a 4-pax-minimum boat is quoted at 4, not unrealistically low.
  minPax Int?

  /// Both modes: physical capacity of the boat. Hard guardrail on the quote screen.
  maxPax Int

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([houseboatId, active])
  @@index([validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Vehicles
// ---------------------------------------------------------------------------

model Vehicle {
  id       String  @id @default(uuid())
  /// "Dzire", "Innova Crysta", "Tempo Traveller 12s"
  type     String
  capacity Int // seats, excluding driver
  notes    String?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates VehicleRate[]

  @@index([active])
}

model VehicleRate {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// VehicleRateType enum: PER_KM | PER_DAY | TRANSFER
  /// PER_DAY is the Kerala norm (a day includes a km allowance); PER_KM and
  /// point-to-point TRANSFER are both still used, so all three are supported.
  rateType String

  seasonLabel String
  validFrom   DateTime
  validTo     DateTime

  /// DEFAULT rate in paise, one per agency tier. Unit depends on rateType:
  /// per km, per day, or flat for the transfer. Both required.
  rateKeralaMinor        Int
  rateOutsideKeralaMinor Int

  /// PER_DAY only: km included before extra-km billing kicks in.
  includedKmPerDay Int?
  /// PER_DAY only: charge per km beyond includedKmPerDay, in paise — one per
  /// tier, both-or-neither. See HotelRate.extraBed*.
  extraKmKeralaMinor        Int?
  extraKmOutsideKeralaMinor Int?
  /// PER_DAY only: driver bata / night halt allowance per day, in paise —
  /// one per tier, both-or-neither. See HotelRate.extraBed*.
  driverAllowanceKeralaMinor        Int?
  driverAllowanceOutsideKeralaMinor Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, active])
  @@index([validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Itineraries / packages
// ---------------------------------------------------------------------------

model Itinerary {
  id             String @id @default(uuid())
  name           String // "5N/6D Munnar - Thekkady - Alleppey"
  durationNights Int

  /// Day-by-day summary. Free text in v1 (structured days are a Phase 5+
  /// question, not a v1 requirement).
  routeSummary String?
  inclusions   String?
  exclusions   String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates ItineraryRate[]

  @@index([active])
}

/// Package pricing, split out of Itinerary so a package can carry seasonal
/// rates in the same [validFrom, validTo] shape as every other product.
model ItineraryRate {
  id          String    @id @default(uuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  /// ItineraryPricingMode enum: PER_PERSON_TWIN_SHARING | PER_PACKAGE
  ///
  /// On the rate row rather than on Itinerary, so a package can be sold per
  /// person in one season and as a flat family rate in another. A package
  /// offering both at once simply has two rate rows for that season, and the
  /// agent sees both as separate priced options.
  pricingMode String

  seasonLabel String
  validFrom   DateTime
  validTo     DateTime

  /// DEFAULT price in paise, one per agency tier. Its UNIT depends on
  /// pricingMode:
  ///   PER_PERSON_TWIN_SHARING -> one person, sharing a twin room
  ///   PER_PACKAGE             -> the whole package, flat, regardless of pax
  /// Both required — see the note on HotelRate.
  priceKeralaMinor        Int
  priceOutsideKeralaMinor Int

  /// PER_PERSON_TWIN_SHARING only: supplement for a solo traveller, per
  /// person — one per tier, both-or-neither. See HotelRate.extraBed*.
  singleSupplementKeralaMinor        Int?
  singleSupplementOutsideKeralaMinor Int?

  /// PER_PACKAGE only: headcount guardrail. The rate is flat regardless of pax,
  /// but a family package still has a ceiling on how many people it can seat.
  /// Null means no ceiling.
  maxPax Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itineraryId, active])
  @@index([validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

model Agent {
  id          String @id @default(uuid())
  agencyName  String
  contactName String

  /// Primary contact. Both `alt` fields are genuinely optional.
  phone    String
  email    String  @unique
  altPhone String?
  altEmail String?

  /// Full postal address of the agency. Multi-line free text.
  ///
  /// Defaulted to "" only so this column could be added to rows that predate
  /// it — the GST/licence text field it replaced was never an address. Every
  /// registration since populates it, and validation.ts requires a real value,
  /// so an empty one means a row older than this migration.
  address String @default("")

  /// AgentTier enum: KERALA | OUTSIDE_KERALA
  ///
  /// Two columns, not one, so the guess and the decision stay distinguishable.
  /// `derivedTier` is best-effort parsing of `address` at registration.
  /// `tierOverride` is Sonet's explicit choice and WINS whenever it is set —
  /// collapsing them into one column would lose the ability to show "we
  /// guessed X, you set Y", and would make a manual choice silently
  /// indistinguishable from a lucky guess.
  ///
  /// Always read through effectiveTier() in src/lib/tier.ts; never read either
  /// column directly for pricing.
  derivedTier  String  @default("KERALA")
  tierOverride String?

  /// AgentStatus enum: pending | approved | rejected
  /// Registration always lands on `pending`. Nothing auto-approves.
  status String @default("pending")

  /// Set at registration; login is refused until status == approved.
  passwordHash String

  /// Set when Sonet issues a temporary password. There is no email provider
  /// and so no self-service reset (see CLAUDE.md) — a temp password is the
  /// only recovery path, and it must not survive first use.
  mustChangePassword Boolean @default(false)

  /// Internal note from Sonet, e.g. why a signup was rejected.
  adminNotes String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?
  lastLoginAt DateTime?

  rateCardEntries AgentRateCard[]
  quotes          Quote[]
  documents       AgentDocument[]

  @@index([status, createdAt])
}

/// Identity and business documents uploaded at registration.
///
/// The files themselves live on disk under UPLOAD_DIR (the same bind mount as
/// prod.db, so they survive container rebuilds); only metadata lives here.
///
/// These are identity documents — a PAN card is sensitive personal data. They
/// are deliberately NOT stored under public/ and are never served statically.
/// The only way to read one is through the admin-authenticated route at
/// /admin/agents/[id]/documents/[kind].
model AgentDocument {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// DocumentKind enum: PAN_CARD | BUSINESS_PROOF | VISITING_CARD
  kind String

  /// Filename on disk, generated — never the name the browser supplied, which
  /// is attacker-controlled and could contain path separators.
  storedName String

  /// What the agent called it. Display and download only, never a filesystem path.
  originalName String

  /// Sniffed from the file's leading bytes, not taken from the upload headers.
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())

  /// One document per kind per agent; re-uploading replaces rather than piles up.
  @@unique([agentId, kind])
  @@index([agentId])
}

/// Per-agent price overrides. This is what makes pricing per-customer rather
/// than one shared B2B rate card.
///
/// FALLBACK RULE (confirmed with Sonet, 25 Aug 2026): if no row exists here
/// for a given product, the agent is quoted the DEFAULT rate from the
/// catalogue table. Absence of an override never blocks a quote.
model AgentRateCard {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// ProductType enum: hotel | houseboat | vehicle | itinerary
  productType String

  /// Points at the specific priced row:
  ///   hotel     -> HotelRate.id
  ///   houseboat -> HouseboatRate.id
  ///   vehicle   -> VehicleRate.id
  ///   itinerary -> ItineraryRate.id
  /// Deliberately not a Prisma relation: it is polymorphic across four
  /// tables. Referential integrity is enforced in the application layer —
  /// see src/lib/rate-card.ts.
  referenceId String

  /// RateCharge enum: MAIN | EXTRA_BED | EXTRA_PAX | EXTRA_KM |
  /// DRIVER_ALLOWANCE | SINGLE_SUPPLEMENT
  ///
  /// Which charge on the referenced row this overrides. MAIN is the headline
  /// rate; the rest are ancillary. One row per charge rather than one wide
  /// row, so an agency can get a special room rate without also inheriting a
  /// special extra-bed rate.
  charge String @default("MAIN")

  /// The agent-specific price, in paise, replacing the tier default for that
  /// charge. Beats BOTH tier defaults.
  overridePriceMinor Int

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, productType, referenceId, charge])
  @@index([agentId, productType])
}

// ---------------------------------------------------------------------------
// Quotes
//
// v1 is QUOTE-ONLY: no booking, no payment, no money movement. These tables
// record what was quoted so an agent can retrieve a quote by reference and so
// Sonet can see what pricing went out. They confer no booking semantics.
// ---------------------------------------------------------------------------

model Quote {
  id      String @id @default(uuid())
  /// Short human reference shown to the agent, e.g. "ST-2609-0042".
  reference String @unique

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// ProductType enum — which quote screen produced this.
  productType String

  /// Trip dates the pricing was resolved against.
  travelStart DateTime
  travelEnd   DateTime

  /// WATCH OUT — this column means different things per product type, because
  /// the four quote screens ask for different things:
  ///   hotel     -> number of ROOMS (the hotel screen never asks a headcount)
  ///   houseboat -> passengers
  ///   itinerary -> travellers
  ///   vehicle   -> 0 (a vehicle hire has no headcount input)
  /// Set in travelWindow() in src/lib/quote-store.ts. Do not read it as a
  /// headcount without checking productType first.
  pax Int

  /// Sum of line totals, in paise.
  totalMinor Int
  currency   String @default("INR")

  /// Frozen copy of the inputs and the resolved pricing, as JSON. Catalogue
  /// rates change; a quote already sent to an agent must not silently change
  /// with them.
  snapshotJson String

  createdAt DateTime @default(now())

  lines QuoteLine[]

  @@index([agentId, createdAt])
}

model QuoteLine {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  description String
  /// nights, days, km, or pax depending on the product.
  quantity    Int
  unitMinor   Int
  totalMinor  Int

  /// True when an AgentRateCard override supplied unitMinor, false when the
  /// catalogue default did. Makes "why is this price what it is" answerable.
  usedOverride Boolean @default(false)

  sortOrder Int @default(0)

  @@index([quoteId])
}
