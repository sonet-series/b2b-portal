// Series Tours — B2B Agent Portal
// Standalone schema. This database has NO relationship to the Frappe/ERPNext
// ERP (`series_tours_app`). Never add a connection, import, or sync to it.
//
// Conventions (see CLAUDE.md for the full rationale):
//  - Money is stored as INTEGER minor units (paise). 1500.50 INR -> 150050.
//    Field names carry the `Minor` suffix so this is impossible to miss.
//  - SQLite has no native enum type. Enum-ish columns are String, and the
//    allowed values live in src/lib/enums.ts as the single source of truth.
//  - Seasons are date ranges (validFrom/validTo), not free-text labels, so the
//    quote engine can resolve a rate from a travel date with no human input.
//  - `active` is a soft-disable everywhere. Catalogue rows are never hard
//    deleted once they have been quoted against.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes a connection URL here. The URL lives in
// prisma.config.ts (for the CLI/migrations) and reaches PrismaClient through
// the better-sqlite3 driver adapter in src/lib/db.ts.
datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

/// Sonet only. v1 deliberately has no multi-admin, no roles, no invites.
model AdminUser {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String?

  /// The seed sets this true, so the password that reaches production through
  /// an env file is dead on first use. Cleared once a real password is chosen.
  mustChangePassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Hotels
// ---------------------------------------------------------------------------

model Hotel {
  id           String   @id @default(uuid())
  name         String
  location     String // town / area, e.g. "Munnar"
  starCategory Int?
  notes        String? // internal only, never shown to agents
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos  ProductPhoto[]
  rates   HotelRate[]
  imports RateSheetImport[]

  @@index([active, location])
}

model HotelRate {
  id      String @id @default(uuid())
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  roomType String // "Deluxe", "Suite", ...
  mealPlan String // MealPlan enum in src/lib/enums.ts: EP | CP | MAP | AP

  /// Human label for the season, shown in admin and on the quote ("Peak").
  seasonLabel String
  /// Inclusive. The quote engine matches a travel date against this window.
  validFrom   DateTime
  /// Inclusive.
  validTo     DateTime

  /// COST per room per night, in paise — what the hotel charges Series Tours.
  ///
  /// Sell prices are NOT stored. Both tiers are derived at read time from this
  /// cost and the current MarkupRule, so editing a markup takes effect on the
  /// next quote rather than leaving stale numbers in the catalogue. See
  /// src/lib/markup.ts.
  ///
  /// An agent rate-card override is an absolute price and beats both tiers.
  costPerNightMinor Int

  /// Extra bed COST per night, in paise. Null when not offered.
  ///
  /// Ancillary charges inherit their PARENT PRODUCT's markup — an extra bed is
  /// marked up by the hotel rule, not one of its own. A single nullable column
  /// replaces the old both-or-neither pair: with one cost there is no second
  /// half to leave blank, so that invariant now holds by shape.
  extraBedCostMinor Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId, active])
  @@index([validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Houseboats
//
// No prior schema existed for these anywhere (unlike hotels and vehicles), so
// this shape is a fresh design. See CLAUDE.md "Houseboat pricing design" for
// why it is modelled per-cruise rather than per-night-per-person.
// ---------------------------------------------------------------------------

model Houseboat {
  id       String  @id @default(uuid())
  name     String
  /// Third-party operator, if we do not run the boat ourselves.
  operator String?
  /// HouseboatCategory enum: Deluxe | Premium | Luxury | Super Luxury
  category String
  bedrooms Int
  location String // "Alleppey", "Kumarakom", ...

  /// Free-text, agent-visible: "AC bedrooms 9pm-6am, upper deck, sundeck".
  amenities String?
  notes     String? // internal only
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos ProductPhoto[]
  rates  HouseboatRate[]

  @@index([active, location, category])
}

/// A photograph of something in the catalogue, shown to AGENTS in the portal.
///
/// Deliberately never on the customer's PDF. That document carries the
/// agency's branding and nothing of ours; our photographs on their letterhead
/// tell their customer who the supplier is. Confirmed with Sonet, 20 Sept 2026.
///
/// ONE table with three nullable foreign keys, rather than a polymorphic
/// `referenceId` like AgentRateCard. That one is polymorphic because it points
/// at four genuinely different rate tables, and it pays for it with
/// `assertReferenceExists()` on every write. Here the three parents are
/// interchangeable, so real foreign keys cost nothing, the database enforces
/// them, and photographs cascade away with the row they belong to.
///
/// EXACTLY ONE of the three is set. SQLite cannot express that and Prisma will
/// not check it, so it is enforced in src/lib/product-photos.ts — which, like
/// validation.ts, is the only write path. Adding a second one breaks that
/// reasoning.
model ProductPhoto {
  id String @id @default(uuid())

  /// Generated name on disk under UPLOAD_DIR. Never the browser's filename.
  storedName String
  /// Sniffed from the bytes at upload, never taken from the Content-Type.
  mimeType   String

  /// Lowest first. The LOWEST is the cover — the one shown wherever a single
  /// picture fits, such as a priced option card. "Make cover" moves a photo
  /// below the current minimum rather than renumbering the whole set.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  vehicleId   String?
  vehicle     Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  hotelId     String?
  hotel       Hotel?     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  houseboatId String?
  houseboat   Houseboat? @relation(fields: [houseboatId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
  @@index([hotelId, sortOrder])
  @@index([houseboatId, sortOrder])
}

model HouseboatRate {
  id          String    @id @default(uuid())
  houseboatId String
  houseboat   Houseboat @relation(fields: [houseboatId], references: [id], onDelete: Cascade)

  /// CruisePackage enum: DAY_CRUISE | OVERNIGHT_22HR | TWO_NIGHT
  cruisePackage String

  /// HouseboatPricingMode enum: WHOLE_BOAT | PER_PERSON
  ///
  /// Lives on the RATE row, not on Houseboat, because the same boat may sell
  /// whole-boat for an overnight cruise and per-person on a day cruise. A boat
  /// that offers both modes for the same duration simply has two rate rows,
  /// and the agent sees both as separate priced options.
  pricingMode String

  /// Meals bundled into the cruise price. Almost always full board for
  /// overnight; kept explicit so a day cruise can differ.
  mealPlan String // MealPlan enum

  seasonLabel String
  validFrom   DateTime
  validTo     DateTime

  /// COST in paise. Its UNIT depends on pricingMode:
  ///   WHOLE_BOAT -> the whole boat, one cruise
  ///   PER_PERSON -> one person, one cruise
  /// Sell prices are derived — see HotelRate.costPerNightMinor.
  costMinor Int

  /// WHOLE_BOAT only: pax covered by rateMinor before extra-pax billing.
  includedPax       Int?
  /// WHOLE_BOAT only: extra-person COST beyond includedPax, per cruise, in
  /// paise. Marked up by the houseboat rule. Null when not offered.
  extraPaxCostMinor Int?

  /// PER_PERSON only: the boat will not run below this headcount, so a 2-pax
  /// enquiry on a 4-pax-minimum boat is quoted at 4, not unrealistically low.
  minPax Int?

  /// Both modes: physical capacity of the boat. Hard guardrail on the quote screen.
  maxPax Int

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([houseboatId, active])
  @@index([validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Vehicles
// ---------------------------------------------------------------------------

model Vehicle {
  id       String  @id @default(uuid())
  /// "Suzuki Dzire", "Toyota Crysta", "17 Seater Tempo Traveller"
  type     String

  /// MAXIMUM PASSENGERS Series Tours will carry — deliberately NOT the seat
  /// count, and often lower. A Fortuner has seven seats but takes four with
  /// luggage aboard, and four is the number a quote must be checked against.
  /// Confirmed with Sonet 19 Sept 2026.
  capacity Int
  notes    String?
  active   Boolean @default(true)

  /// Where this sits in the fleet, lowest first. Sonet's order, not ours.
  ///
  /// The list is a sales order — what he wants put in front of an agent first
  /// — and that is not the same as cheapest, largest, or alphabetical. Seeded
  /// from the old capacity ordering so the first view after deploying matches
  /// what was there before.
  ///
  /// Kept CONTIGUOUS by `reorderVehicle`, which renumbers the whole list on
  /// every move. With a dozen vehicles that costs nothing and makes ties —
  /// and the ordering bugs that come with them — impossible.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Up to PHOTO_LIMIT.vehicle of them — see src/lib/product-photos.ts.
  photos     ProductPhoto[]
  rates      VehicleRate[]
  garages    GarageVehicle[]
  tollRate   VehicleTollRate?
  permits    StatePermit[]

  @@index([active])
}

model VehicleRate {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// VehicleRateType enum: PER_KM | PER_DAY | TRANSFER
  /// PER_DAY is the Kerala norm (a day includes a km allowance); PER_KM and
  /// point-to-point TRANSFER are both still used, so all three are supported.
  rateType String

  seasonLabel String
  validFrom   DateTime
  validTo     DateTime

  /// COST in paise. Unit depends on rateType: per km, per day, or flat for
  /// the transfer. Sell prices are derived.
  costMinor Int

  /// PER_DAY only: km included before extra-km billing kicks in.
  includedKmPerDay         Int?
  /// PER_DAY only: COST per km beyond includedKmPerDay, in paise. Marked up
  /// by the vehicle rule. Null when not offered.
  extraKmCostMinor         Int?
  /// PER_DAY only: driver bata / night halt COST per day, in paise. Marked up
  /// by the vehicle rule. Null when not offered.
  driverAllowanceCostMinor Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, active])
  @@index([validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Itineraries / packages
// ---------------------------------------------------------------------------

model Itinerary {
  id             String @id @default(uuid())
  name           String // "5N/6D Munnar - Thekkady - Alleppey"
  durationNights Int

  /// Day-by-day summary. Free text in v1 (structured days are a Phase 5+
  /// question, not a v1 requirement).
  routeSummary String?
  inclusions   String?
  exclusions   String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates ItineraryRate[]

  @@index([active])
}

/// Package pricing, split out of Itinerary so a package can carry seasonal
/// rates in the same [validFrom, validTo] shape as every other product.
model ItineraryRate {
  id          String    @id @default(uuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  /// ItineraryPricingMode enum: PER_PERSON_TWIN_SHARING | PER_PACKAGE
  ///
  /// On the rate row rather than on Itinerary, so a package can be sold per
  /// person in one season and as a flat family rate in another. A package
  /// offering both at once simply has two rate rows for that season, and the
  /// agent sees both as separate priced options.
  pricingMode String

  seasonLabel String
  validFrom   DateTime
  validTo     DateTime

  /// COST in paise. Its UNIT depends on pricingMode:
  ///   PER_PERSON_TWIN_SHARING -> one person, sharing a twin room
  ///   PER_PACKAGE             -> the whole package, flat, regardless of pax
  /// Sell prices are derived — see HotelRate.costPerNightMinor.
  costMinor Int

  /// PER_PERSON_TWIN_SHARING only: solo-traveller supplement COST, per
  /// person. Marked up by the package rule. Null when not offered.
  singleSupplementCostMinor Int?

  /// PER_PACKAGE only: headcount guardrail. The rate is flat regardless of pax,
  /// but a family package still has a ceiling on how many people it can seat.
  /// Null means no ceiling.
  maxPax Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itineraryId, active])
  @@index([validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

model Agent {
  id          String @id @default(uuid())
  agencyName  String
  contactName String

  /// Primary contact. Both `alt` fields are genuinely optional.
  phone    String
  email    String  @unique
  altPhone String?
  altEmail String?

  /// Full postal address of the agency. Multi-line free text.
  ///
  /// Defaulted to "" only so this column could be added to rows that predate
  /// it — the GST/licence text field it replaced was never an address. Every
  /// registration since populates it, and validation.ts requires a real value,
  /// so an empty one means a row older than this migration.
  address String @default("")

  /// AgentTier enum: KERALA | OUTSIDE_KERALA
  ///
  /// Two columns, not one, so the guess and the decision stay distinguishable.
  /// `derivedTier` is best-effort parsing of `address` at registration.
  /// `tierOverride` is Sonet's explicit choice and WINS whenever it is set —
  /// collapsing them into one column would lose the ability to show "we
  /// guessed X, you set Y", and would make a manual choice silently
  /// indistinguishable from a lucky guess.
  ///
  /// Always read through effectiveTier() in src/lib/tier.ts; never read either
  /// column directly for pricing.
  derivedTier  String  @default("KERALA")
  tierOverride String?

  /// AgentStatus enum: pending | approved | rejected
  /// Registration always lands on `pending`. Nothing auto-approves.
  status String @default("pending")

  /// Set at registration; login is refused until status == approved.
  passwordHash String

  /// Set when Sonet issues a temporary password. There is no email provider
  /// and so no self-service reset (see CLAUDE.md) — a temp password is the
  /// only recovery path, and it must not survive first use.
  mustChangePassword Boolean @default(false)

  /// Internal note from Sonet, e.g. why a signup was rejected.
  adminNotes String?

  /// The agency's own logo, for the quote they print and hand to their
  /// customer. Stored on disk under UPLOAD_DIR like every other upload, not in
  /// SQLite — blobs would bloat every .backup copy, and cheap copying is the
  /// whole point of a single-file database.
  ///
  /// Deliberately NOT an AgentDocument. Those are identity papers: sensitive,
  /// admin-only, and never served to the agent. A logo is the exact opposite —
  /// it exists to be displayed, and the agent reads their own. Putting them in
  /// one table would mean one access rule for two opposite kinds of file.
  ///
  /// Nullable as a pair: an agency without a logo prints an unbranded quote
  /// rather than being blocked from printing at all.
  logoStoredName String?
  logoMimeType   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
  lastLoginAt DateTime?

  rateCardEntries AgentRateCard[]
  quotes          Quote[]
  bookings        Booking[]
  documents       AgentDocument[]

  @@index([status, createdAt])
}

/// Identity and business documents uploaded at registration.
///
/// The files themselves live on disk under UPLOAD_DIR (the same bind mount as
/// prod.db, so they survive container rebuilds); only metadata lives here.
///
/// These are identity documents — a PAN card is sensitive personal data. They
/// are deliberately NOT stored under public/ and are never served statically.
/// The only way to read one is through the admin-authenticated route at
/// /admin/agents/[id]/documents/[kind].
model AgentDocument {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// DocumentKind enum: PAN_CARD | BUSINESS_PROOF | VISITING_CARD
  kind String

  /// Filename on disk, generated — never the name the browser supplied, which
  /// is attacker-controlled and could contain path separators.
  storedName String

  /// What the agent called it. Display and download only, never a filesystem path.
  originalName String

  /// Sniffed from the file's leading bytes, not taken from the upload headers.
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())

  /// One document per kind per agent; re-uploading replaces rather than piles up.
  @@unique([agentId, kind])
  @@index([agentId])
}

/// Per-agent price overrides. This is what makes pricing per-customer rather
/// than one shared B2B rate card.
///
/// FALLBACK RULE (confirmed with Sonet, 25 Aug 2026): if no row exists here
/// for a given product, the agent is quoted the DEFAULT rate from the
/// catalogue table. Absence of an override never blocks a quote.
model AgentRateCard {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// ProductType enum: hotel | houseboat | vehicle | itinerary
  productType String

  /// Points at the specific priced row:
  ///   hotel     -> HotelRate.id
  ///   houseboat -> HouseboatRate.id
  ///   vehicle   -> VehicleRate.id
  ///   itinerary -> ItineraryRate.id
  /// Deliberately not a Prisma relation: it is polymorphic across four
  /// tables. Referential integrity is enforced in the application layer —
  /// see src/lib/rate-card.ts.
  referenceId String

  /// RateCharge enum: MAIN | EXTRA_BED | EXTRA_PAX | EXTRA_KM |
  /// DRIVER_ALLOWANCE | SINGLE_SUPPLEMENT
  ///
  /// Which charge on the referenced row this overrides. MAIN is the headline
  /// rate; the rest are ancillary. One row per charge rather than one wide
  /// row, so an agency can get a special room rate without also inheriting a
  /// special extra-bed rate.
  charge String @default("MAIN")

  /// The agent-specific price, in paise, replacing the tier default for that
  /// charge. Beats BOTH tier defaults.
  overridePriceMinor Int

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, productType, referenceId, charge])
  @@index([agentId, productType])
}

// ---------------------------------------------------------------------------
// Quotes
//
// v1 is QUOTE-ONLY: no booking, no payment, no money movement. These tables
// record what was quoted so an agent can retrieve a quote by reference and so
// Sonet can see what pricing went out. They confer no booking semantics.
// ---------------------------------------------------------------------------

model Quote {
  id        String @id @default(uuid())
  /// Short human reference shown to the agent, e.g. "ST-2609-0042".
  reference String @unique

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// ProductType enum, or "combined" when the quote holds more than one
  /// product. Single-product quotes keep their own type so the list stays
  /// readable at a glance.
  productType String

  /// Trip dates the pricing was resolved against.
  travelStart DateTime
  travelEnd   DateTime

  /// WATCH OUT — this column means different things per product type, because
  /// the four quote screens ask for different things:
  ///   hotel     -> number of ROOMS (the hotel screen never asks a headcount)
  ///   houseboat -> passengers
  ///   itinerary -> travellers
  ///   vehicle   -> 0 (a vehicle hire has no headcount input)
  ///   combined  -> 0 (no single headcount spans a mixed trip)
  /// Set in travelWindow() in src/lib/quote-store.ts. Do not read it as a
  /// headcount without checking productType first.
  pax Int

  /// Sum of line totals, in paise.
  totalMinor Int
  currency   String @default("INR")

  /// Frozen copy of the inputs and the resolved pricing, as JSON. Catalogue
  /// rates change; a quote already sent to an agent must not silently change
  /// with them.
  snapshotJson String

  createdAt DateTime @default(now())

  lines   QuoteLine[]
  booking Booking?

  @@index([agentId, createdAt])
}

/// An agent's request to turn a saved quote into a real trip.
///
/// v1 is QUOTE-ONLY plus this: a REQUEST and an APPROVAL, never a transaction.
/// No money moves through the portal. The agent pays Series Tours by whatever
/// means they already use, then RECORDS that payment here with proof, and
/// Sonet verifies it. That is a ledger, not a payment rail — see BookingPayment.
///
/// Confirmed with Sonet, 20 Sept 2026.
model Booking {
  id        String @id @default(uuid())
  /// "SB-2609-0007" — S for Series, B for booking. Distinct from a quote's
  /// ST- prefix on purpose: down a phone line nobody should have to ask which
  /// kind of number they are reading.
  reference String @unique

  /// ONE booking per quote. A second request against the same quote would be
  /// two promises about one trip; re-quote instead.
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// BookingStatus: REQUESTED | CONFIRMED | DECLINED | CANCELLED
  status String @default("REQUESTED")

  /// What was agreed, NET of GST, in paise.
  ///
  /// Starts as the quote's total and Sonet may change it when he approves —
  /// "on approval final rate might change". Stored on the BOOKING rather than
  /// written back to the quote: the quote is a frozen record of what was
  /// priced, and a booking is a separate agreement about what will be paid.
  agreedTotalMinor Int
  /// The GST rate at the moment of agreement, basis points. Frozen, because a
  /// statutory change must not silently restate a confirmed booking.
  gstBps           Int
  /// Deposit due, basis points of the GROSS total (2500 = 25%). Frozen for
  /// the same reason.
  depositBps       Int

  /// Anything the agent wants Sonet to know when requesting.
  agentNote String?
  /// Sonet's reply — REQUIRED in practice when he changes the rate or
  /// declines, because an unexplained change is the one an agent argues with.
  adminNote String?

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?

  // --- who is travelling, and how they arrive -------------------------------
  // Asked for 21 Sept 2026. All nullable: an agent rarely has flight numbers
  // at the moment they request a booking, and refusing the request until they
  // do would push the whole conversation back onto WhatsApp.
  leadGuestName  String?
  leadGuestPhone String?
  leadGuestEmail String?

  /// Wall-clock times as "HH:MM" STRINGS, not DateTimes.
  ///
  /// A flight lands at 06:40 local time. Storing that as an instant means
  /// choosing a timezone, and the first time anything renders it in another
  /// one the driver is sent at the wrong hour. The date beside it is a real
  /// calendar day, like every other date here.
  arrivalDate     DateTime?
  arrivalTime     String?
  arrivalFlight   String?
  arrivalFrom     String?

  departureDate   DateTime?
  departureTime   String?
  departureFlight String?
  departureTo     String?

  // --- the ERP push ---------------------------------------------------------
  // See TODO.md item 2 and src/lib/erp.ts. The portal never reads from the
  // ERP; these columns only record what it sent and whether that worked.
  /// The document name the ERP gave back, e.g. "SAL-ORD-2026-00123".
  /// Its PRESENCE is what makes the push idempotent — set, and we never send
  /// this booking again.
  erpReference String?
  erpPushedAt  DateTime?
  /// The last failure, verbatim. Kept so a retry is an informed decision.
  erpError     String?
  erpAttempts  Int       @default(0)

  payments BookingPayment[]
  guests   BookingGuest[]
  stays    BookingStay[]

  @@index([status, requestedAt])
  @@index([agentId, requestedAt])
}

/// A person travelling on a booking.
///
/// Separate rows rather than one free-text box: hotels ask for names one at a
/// time, and a list that can be read back is worth more than a paragraph
/// somebody has to parse. The party SIZE already lives on the quote; this is
/// the names, which nothing else knows.
model BookingGuest {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name String
  /// Years at the time of travel. Optional — an adult's age is nobody's
  /// business, a child's decides a hotel's policy.
  age  Int?

  sortOrder Int @default(0)

  @@index([bookingId, sortOrder])
}

/// Where the party sleeps on one night of the trip.
///
/// One row per NIGHT, keyed by the itinerary day it follows, so it lines up
/// with the day plan the quote was priced on rather than floating free of it.
model BookingStay {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// 0-based, matching ItineraryDay. Unique per booking so seeding the rows
  /// from the day plan is safe to repeat.
  dayIndex Int
  date     DateTime
  /// The town they are in that night, seeded from the itinerary.
  place    String

  /// The hotel or resort. FREE TEXT on purpose: agents book plenty of
  /// properties Series Tours does not carry, and forcing a catalogue pick
  /// would make the field unusable exactly when it matters.
  property        String?
  confirmationRef String?
  notes           String?

  @@unique([bookingId, dayIndex])
  @@index([bookingId, dayIndex])
}

/// A payment the agent says they have made, and Sonet's verdict on it.
///
/// This records money that moved SOMEWHERE ELSE — a bank transfer, UPI,
/// whatever the agency already uses. The portal never touches it. The proof is
/// an image or PDF the agent uploads, stored on disk like every other upload.
///
/// NOTHING counts toward the balance until `status` is APPROVED. A submitted
/// payment is a claim; an approved one is a fact, and the difference is the
/// whole point of Sonet reviewing them.
model BookingPayment {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// What the agent says they paid, in paise.
  amountMinor Int
  /// Their bank/UPI reference, so Sonet can find it on a statement.
  reference   String?
  /// The day the agent says the money left. Not when they told us.
  paidOn      DateTime?
  note        String?

  /// The screenshot or receipt. On disk under UPLOAD_DIR, never in SQLite and
  /// never under public/ — same rule as agent documents.
  storedName String
  mimeType   String

  /// PaymentStatus: SUBMITTED | APPROVED | REJECTED
  status    String  @default("SUBMITTED")
  adminNote String?

  submittedAt DateTime  @default(now())
  decidedAt   DateTime?

  @@index([bookingId, submittedAt])
  @@index([status, submittedAt])
}

model QuoteLine {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  description String
  /// nights, days, km, or pax depending on the product.
  quantity    Int
  unitMinor   Int
  totalMinor  Int

  /// True when an AgentRateCard override supplied unitMinor, false when the
  /// catalogue default did. Makes "why is this price what it is" answerable.
  usedOverride Boolean @default(false)

  /// Which product this line came from. Lines had no provenance before, which
  /// is fine while a quote holds one product and useless once it holds four —
  /// a combined quote has to be able to group its lines back into the items
  /// the agent added.
  ///
  /// Nullable only so lines written before combined quoting existed still
  /// load; everything written since sets it.
  productType String?

  /// Groups lines belonging to the same added item. A hotel stay that splits
  /// across two seasons produces two lines with the SAME itemIndex — the split
  /// is pricing detail within one thing the agent chose, not two choices.
  itemIndex Int @default(0)

  /// What the agent picked, e.g. "Demo Hill Resort · Deluxe · CP". Frozen at
  /// save time so a saved quote reads correctly even if the catalogue is
  /// renamed later.
  itemLabel String?

  sortOrder Int @default(0)

  @@index([quoteId])
}

/// How a cost becomes the two agent-facing sell prices.
///
/// Editable by Sonet at /admin/settings — the markup must not require a code
/// change. Exactly one row per (productType, tier); the seed creates all eight
/// and nothing deletes them.
///
/// Changing a rule affects FUTURE calculations only. Saved Quote/QuoteLine
/// rows keep the numbers they were saved with, because they store computed
/// totals rather than referencing this table.
model MarkupRule {
  id String @id @default(uuid())

  /// ProductType enum: hotel | houseboat | vehicle | itinerary
  productType String
  /// AgentTier enum: KERALA | OUTSIDE_KERALA
  tier        String

  /// MarkupKind enum: FLAT | PERCENT
  kind String

  /// ONE required column whose meaning follows `kind`:
  ///   FLAT    -> paise added to the cost   (₹100 -> 10000)
  ///   PERCENT -> basis points added        (5%   -> 500)
  ///
  /// Basis points rather than a float, for the same reason money is Int: the
  /// arithmetic must be exact. A nullable pair would allow a rule whose kind
  /// points at a missing number; this cannot.
  value Int

  updatedAt DateTime @updatedAt

  @@unique([productType, tier])
}

/// An uploaded hotel rate sheet and what the AI extracted from it.
///
/// Extraction results are STAGED here, never written straight to HotelRate.
/// A bad extraction becomes a wrong price quoted to a real customer, so a
/// human confirms every row first. Staging in the database rather than the
/// browser means a review of sixty rows survives a refresh, and leaves a
/// record of what was proposed versus what was accepted.
model RateSheetImport {
  id      String @id @default(uuid())
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  /// The uploaded file, kept so a disputed rate can be checked against source.
  storedName   String
  originalName String
  mimeType     String
  sizeBytes    Int

  /// ImportStatus enum: PENDING_REVIEW | CONFIRMED | DISCARDED
  status String @default("PENDING_REVIEW")

  /// Which model produced these rows, so a systematic error is traceable.
  model String

  /// Anything the model flagged about the sheet as a whole.
  notes String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  rows RateSheetRow[]

  @@index([hotelId, status])
}

/// One proposed HotelRate, held for review.
///
/// Fields are stored as STRINGS exactly as the manual rate form would submit
/// them. On confirm each row is fed through the same zod schema and the same
/// create call as manual entry — so a staged row is literally a form
/// submission, and there is no second write path that could drift from the
/// first.
model RateSheetRow {
  id       String          @id @default(uuid())
  importId String
  import   RateSheetImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  roomType    String
  mealPlan    String
  seasonLabel String
  /// ISO YYYY-MM-DD, or "" when the model could not read a date confidently.
  validFrom   String
  validTo     String
  /// Rupees as typed, e.g. "4500" — converted to paise by the shared schema.
  costInput   String

  /// Confidence enum: HIGH | LOW. LOW rows are surfaced for attention; they
  /// are not rejected, because the reviewer is the one who decides.
  confidence String  @default("HIGH")
  /// Why the model was unsure, in its own words.
  issues     String?

  /// Cleared by the reviewer to drop a row without deleting the audit trail.
  included Boolean @default(true)

  sortOrder Int @default(0)

  @@index([importId])
}


// ---------------------------------------------------------------------------
// Garages, and the road distances quoted against them
// ---------------------------------------------------------------------------

/// A depot a vehicle is dispatched from.
///
/// This exists because a Kerala vehicle hire is billed GARAGE TO GARAGE, not
/// pickup to drop. A car sent from Cochin to collect a party at Cochin airport,
/// run to Madurai and released there has still driven Madurai -> Cochin empty,
/// and that leg is chargeable. Quoting from the pickup point alone silently
/// loses it, which is how an operator ends up eating a few hundred km.
model Garage {
  id String @id @default(uuid())

  /// Short name the agent picks from: "Cochin", "Trivandrum".
  name String @unique

  /// The address Google routes from. Needs to be specific enough to resolve
  /// to one place — a bare town name can land anywhere in the district, and
  /// every quote from this depot inherits that error.
  address String

  /// The state this depot sits in, and therefore the HOME state for any hire
  /// dispatched from it.
  ///
  /// On the depot rather than a constant because home is a property of where
  /// the vehicle starts, not of the company. A Chennai depot makes Tamil Nadu
  /// home and Kerala the state needing a permit — the exact inverse of Kochi.
  /// Hardcoding Kerala would have quietly charged the wrong permits, or none,
  /// the day a second depot opened outside it.
  ///
  /// Must match the state names in src/lib/destinations.ts exactly.
  state String @default("Kerala")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles GarageVehicle[]

  @@index([active])
}

/// Which vehicle types a garage actually holds.
///
/// Not every garage keeps every vehicle — a 26-seat coach may exist only at
/// Cochin. The agent picks a garage first and is then offered only what can
/// genuinely be dispatched from it, so an impossible hire cannot be quoted.
model GarageVehicle {
  id String @id @default(uuid())

  garageId String
  garage   Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([garageId, vehicleId])
  @@index([garageId, active])
}

/// A cached road distance between two places.
///
/// Every routed hop costs a Google Routes API call, and the same hops recur
/// constantly — Cochin -> Munnar is the same road for every agent who quotes
/// it. Caching keeps a busy day from turning into a bill, and keeps a quote
/// refreshable when the API is briefly unreachable.
///
/// Distance is stored in exact integer METRES for the same reason money is
/// stored in paise: rounding to km at rest and summing afterwards loses
/// kilometres across a ten-hop itinerary. Conversion happens at the edge, in
/// src/lib/distance.ts.
model RoadDistance {
  id String @id @default(uuid())

  /// Both sides are already normalised by normalisePlace() before they reach
  /// here. Never write a raw user string to these columns or the cache will
  /// miss on nothing more than a stray capital letter.
  origin      String
  destination String

  meters  Int
  seconds Int

  /// DistanceSource enum: GOOGLE | MANUAL
  /// MANUAL rows are distances a human typed when routing was unavailable.
  /// They are kept apart so a typed number is never mistaken for a routed one.
  source String

  /// Every state this hop's road actually passes through, comma separated.
  ///
  /// Derived by sampling the route polyline and reverse-geocoding the samples,
  /// because a permit is due for a state you DRIVE THROUGH, not only one you
  /// stop in. Kochi to Bangalore names no Tamil Nadu stop and crosses Tamil
  /// Nadu for most of its length.
  ///
  /// Cached with the distance for the same reason: the road between two places
  /// does not change, so this is computed once per hop, ever.
  ///
  /// NULL on rows cached before this existed, and on any hop whose geocoding
  /// failed. Null means UNKNOWN, never "no states" — see src/lib/geocode.ts.
  statesCsv String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([origin, destination])
}


/// A small key/value store for operational numbers Sonet tunes.
///
/// Deliberately not env vars: these change from the admin screen without a
/// redeploy. Deliberately not MarkupRule either — a markup turns cost into a
/// sell price, and these do not.
///
/// `value` is an integer whose unit depends on the key, documented in
/// src/lib/settings.ts. Integers for the same reason money is paise: the
/// arithmetic has to be exact and reproducible.
model Setting {
  key   String @id
  value Int

  updatedAt DateTime @updatedAt
}


/// Toll and parking allowed per day, per vehicle type.
///
/// Per vehicle because a 17-seat coach pays materially more at a toll booth
/// than a Dzire, and quoting one figure for both is wrong in one direction or
/// the other every time.
///
/// Optional per vehicle: `Setting.tollParkingPerDayMinor` is the fallback.
/// Toll applies to EVERY hire, so a vehicle without a row must still quote
/// rather than block — unlike a permit, which only applies when a trip
/// actually crosses a border.
model VehicleTollRate {
  id String @id @default(uuid())

  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Per day of hire, in paise. COST, not the agent price.
  costMinor Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An interstate permit fee, per state entered, per vehicle type.
///
/// Both dimensions are real: the fee differs by state, and within a state it
/// differs by seating capacity — a 26-seat coach and a sedan are not charged
/// the same to enter Tamil Nadu.
///
/// Stored as COST and marked up by the vehicle rule, like every other charge
/// on a hire. See src/lib/ancillary.ts.
model StatePermit {
  id String @id @default(uuid())

  /// Must match the state names in src/lib/destinations.ts exactly — that list
  /// is what decides which states an itinerary enters.
  state String

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Per entry, in paise. COST, not the agent price.
  costMinor Int

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([state, vehicleId])
  @@index([state, active])
}
